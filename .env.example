# No credentials included. Provision locally; see README.
ATLAS_DATABASE_PATH=.local/atlas.db
ATLAS_CREDENTIALS_PATH=.local/credentials.json
ATLAS_MAX_UPLOAD_BYTES=262144
ATLAS_CHUNK_SIZE=800
ATLAS_CHUNK_OVERLAP=120
# Optional PostgreSQL: bootstrap with atlas.worker init-local, migrate, then
# generate restricted runtime files with atlas.deployment init-runtime.
# Do not set both ATLAS_POSTGRES_DSN and ATLAS_POSTGRES_DSN_PATH.
# ATLAS_POSTGRES_DSN_PATH=.local/runtime.dsn
# Linux Compose only: match the non-root owner of private credential files.
# ATLAS_RUNTIME_UID=10001
# ATLAS_RUNTIME_GID=10001
# Models must be installed in a local Ollama instance; vector search requires PG.
ATLAS_GENERATION_ENABLED=false
ATLAS_VECTOR_ENABLED=false
ATLAS_OLLAMA_URL=http://127.0.0.1:11434
ATLAS_EMBEDDING_MODEL=all-minilm:latest
ATLAS_GENERATION_MODEL=qwen3:1.7b
# Optional same-origin frontend after npm run build:
# ATLAS_FRONTEND_DIR=frontend/dist

